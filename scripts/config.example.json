{
  "enabled": false,
  "sender": "your-address@gmail.com",
  "recipients": [
    "your-address@gmail.com"
  ],
  "smtp_host": "smtp.gmail.com",
  "smtp_port": 587,
  "imap_host": "imap.gmail.com",
  "imap_port": 993,
  "password_env": "CODEX_GMAIL_APP_PASSWORD",
  "dpapi_secret_file": "gmail_app_password.dpapi",
  "subject_prefix": "[Codex]",
  "max_subject_task_chars": 36,
  "self_report_subject_is_task_name": true,
  "inbox_enabled": false,
  "inbox_subject_tag": "[codex-next]",
  "allowed_senders": ["your-address@gmail.com"],
  "poll_seconds": 60,
  "python_exe": "python",
  "codex_cwd": "C:\\path\\to\\your\\project",
  "codex_exe": "codex",
  "codex_sandbox": "read-only",
  "codex_timeout_seconds": 1800,
  "command_mode": "exec",
  "default_target_session": "",
  "include_git_summary": true,
  "max_git_files": 30,
  "mobile_reply_hint": "用手机回邮件时，主题写 [codex-next] 可开新后台任务；写 [codex-next:会话ID或任务名] 可指定已有 Codex 会话。",
  "max_body_chars": 15000,
  "original_notify": []
}
